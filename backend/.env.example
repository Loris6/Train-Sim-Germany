# Train Sim Germany – Backend-Einstellungen (optional; die Anmeldung braucht nur die Client-ID in assets/js/config.js)
# Für Node.js: diese Datei nach .env kopieren und ausfüllen. .env NIE hochladen (steht in .gitignore).
# Für Cloudflare: Werte in wrangler.toml bzw. als Secret eintragen (siehe README.md).

# Dieselbe Client-ID wie in assets/js/config.js (nicht geheim). Nötig für Bewerbungen und Privatsphäre.
ROBLOX_CLIENT_ID=7832208484042432028

# Adresse der Web-App (mit / am Ende) und weitere erlaubte Adressen (mit Komma getrennt)
APP_URL=https://loris6.github.io/Train-Sim-Germany/
ALLOWED_ORIGINS=http://localhost:8000

# Roblox-Gruppe für den Rang
ROBLOX_GROUP_ID=33684346

# Optional: Bewerbungen in einen privaten Discord-Kanal senden (Kanal → Integrationen → Webhooks).
# GEHEIM: nur in backend/.env (wird nicht hochgeladen) oder als Cloudflare-Secret eintragen – nie hier!
DISCORD_WEBHOOK_URL=

# Optional: Kontakt für Web-Push (mailto: oder https:), sonst APP_URL
PUSH_CONTACT=

# Optional: eigener geheimer Schlüssel für Sitzungen (sonst erzeugt das Backend selbst einen)
SESSION_SECRET=

# Optional (Node.js): Port und Datei für die Daten
PORT=8787
DATA_FILE=data/store.json

# Nur für Tests: andere Adressen statt der Roblox-APIs
# ROBLOX_OAUTH_URL=
# ROBLOX_USERS_URL=
# ROBLOX_GROUPS_URL=
# ROBLOX_THUMBNAILS_URL=
