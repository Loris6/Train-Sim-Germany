# Train Sim Germany – Backend-Einstellungen
# Für Node.js: diese Datei nach .env kopieren und ausfüllen. .env NIE hochladen (steht in .gitignore).
# Für Cloudflare: Werte als Secrets bzw. in wrangler.toml eintragen (siehe README.md).

# Roblox OAuth 2.0 App (https://create.roblox.com/dashboard/credentials → OAuth 2.0 Apps)
ROBLOX_CLIENT_ID=7832208484042432028
ROBLOX_CLIENT_SECRET=RBX-S3_FLMGf0UKDXKf82GNCmHahjz-y2IVaRVzqdznTQIAyIonfn1uqda6jG6rt9aAF

# Zufälliger, geheimer Text mit mindestens 32 Zeichen, z. B. von:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# Adresse der Web-App (mit / am Ende) und weitere erlaubte Adressen (mit Komma getrennt)
APP_URL=https://loris6.github.io/Train-Sim-Germany/
ALLOWED_ORIGINS=http://localhost:8000

# Eigene Adresse des Backends (für die Redirect-URL bei Roblox: <BACKEND_URL>/auth/callback)
BACKEND_URL=http://localhost:8787

# Optional: Rang aus der Roblox-Gruppe übernehmen (Gruppen-ID als Zahl)
ROBLOX_GROUP_ID=33684346

# Optional: Bewerbungen in einen Discord-Kanal senden (Kanal → Integrationen → Webhooks)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1562179123537907963/NXZWsHyU1nKuThJyhtcnqG5owKF9VQFmdbrgcBAODIG6Jz5WKzk1GEcGyp4EuXkyHQPe

# Optional (Node.js): Port und Datei für die Daten
PORT=8787
DATA_FILE=data/store.json

# Nur für Tests: andere Adressen statt der Roblox-APIs
# ROBLOX_OAUTH_URL=
# ROBLOX_USERS_URL=
# ROBLOX_GROUPS_URL=
# ROBLOX_THUMBNAILS_URL=
